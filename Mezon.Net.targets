<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Versioning (NuGet SemVer 2.0). All packable projects share VersionPrefix.

    Stable release:   VersionPrefix=1.0.0  IsTagBuild=true                 -> 1.0.0
    Pre-release:      VersionPrefix=1.1.0  VersionSuffix=preview.1
                      IsTagBuild=true                                      -> 1.1.0-preview.1
                      (also rc.1 / beta.1)
    Local build:      (defaults)                                           -> 1.0.0-dev
    CI build:         BuildNumber=42 (no IsTagBuild)                       -> 1.0.0-ci.42

    Git tags should match the package: v1.0.0, v1.1.0-preview.1, …
    GitHub Actions publish workflow packs with -p:PackageVersion from the tag (v prefix stripped).
    Bump MAJOR for breaking API, MINOR for features, PATCH for fixes.
  -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <LangVersion>latest</LangVersion>
    <Authors>Mezon.Net Contributors</Authors>
    <Company>Mezon.Net</Company>
    <Copyright>Copyright (c) Mezon.Net Contributors</Copyright>
    <PackageTags>mezon;mezon.net;mezon.ai;chat;bot;realtime;websocket;protobuf</PackageTags>
    <PackageProjectUrl>https://github.com/huy-buidoanquang/Mezon.NET</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>PackageLogo.png</PackageIcon>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/huy-buidoanquang/Mezon.NET</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Tag / release builds: keep an explicit VersionSuffix (preview.1); optional BuildNumber overrides it. -->
  <PropertyGroup Condition=" '$(IsTagBuild)' == 'true' ">
    <VersionSuffix Condition=" '$(BuildNumber)' != '' ">$(BuildNumber)</VersionSuffix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Non-tag: default to -dev or -ci.<n> only when VersionSuffix was not set explicitly. -->
  <PropertyGroup Condition=" '$(IsTagBuild)' != 'true' And '$(VersionSuffix)' == '' And '$(BuildNumber)' == '' ">
    <VersionSuffix>dev</VersionSuffix>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(IsTagBuild)' != 'true' And '$(VersionSuffix)' == '' And '$(BuildNumber)' != '' ">
    <VersionSuffix>ci.$(BuildNumber)</VersionSuffix>
  </PropertyGroup>

  <!-- XML docs for IntelliSense / NuGet; missing docs suppressed until full public API coverage. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <NoWarn>$(NoWarn);CS1573;CS1591</NoWarn>
    <WarningsAsErrors>true</WarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)docs\marketing\logo\PackageLogo.png" Pack="true" PackagePath="" Condition="Exists('$(MSBuildThisFileDirectory)docs\marketing\logo\PackageLogo.png')" />
    <None Include="$(MSBuildThisFileDirectory)NUGET_README.md" Pack="true" PackagePath="" Condition="Exists('$(MSBuildThisFileDirectory)NUGET_README.md')" />
  </ItemGroup>
</Project>
